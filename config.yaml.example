default_provider: ollama

providers:
  ollama:
    model: gemma4
    base_url: http://localhost:11434/v1
    api_key_env: OLLAMA_API_KEY
    temperature: 0.0
    max_concurrency: 1
  eosc:
    model: <choose-model-name>
    base_url: https://vllm.cloud.ai4eosc.eu
    api_key_env: EOSC_API_KEY
    temperature: 0.0
    max_concurrency: 1
